# Python caches & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Secrets & Environment variables
.env
*.env.local

# SQLite Local Database (preserve schema.sql and seed.py, do not commit real local DB)
database/*.db
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite

# Storage & Uploads (preserve .gitkeep, do not commit sensitive user uploads or generated PDFs/Excels)
storage/uploads/*
!storage/uploads/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
frontend/web/static/uploads/*
!frontend/web/static/uploads/.gitkeep
reports/*.pdf
reports/*.xlsx

# ML Model large binary artifacts (can be re-trained with train() or tracked via Git LFS / release storage)
# Keep lightweight metrics.json and dataset if desired, ignore giant binary joblib files
*.joblib

# IDE & Editor artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage caches
.pytest_cache/
.coverage
htmlcov/
