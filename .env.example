# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit your real .env file with secrets or production credentials to Git!
# ==============================================================================

# Application Security
SECRET_KEY=change-this-super-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_EXPIRATION_HOURS=24

# Password Reset Email Destination
# All forgot-password verification codes are delivered to this address
FORGOT_PASSWORD_TARGET_EMAIL=admin@example.com

# SMTP / Email Configuration (e.g. Gmail SMTP)
# 1. Use your sender email for MAIL_USERNAME
# 2. Generate an App Password for MAIL_PASSWORD
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=ProductivityAI <your-email@example.com>

# Database Settings
# Leave MYSQL_USER and MYSQL_PASSWORD empty to run on SQLite out-of-the-box.
# Set them to connect to MySQL database.
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=employee_productivity_ai

# CORS Allowed Origins (Comma-separated, '*' for development)
CORS_ORIGINS=*
